    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug executable 'lua'",
            "type": "lldb",
            "request": "launch",
            "program": "${cwd}/target/debug/lua",
            "args": [
                "${cwd}/test/spsc.lua"
            ]
        },
        {
            "name": "Debug executable 'luac'",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "run",
                    "--bin=luac"
                ]
            },
            "args": []
        },
        {
            "name": "Debug unit tests in executable 'luac'",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "test",
                    "--bin=luac"
                ]
            }
        }
    ]
}